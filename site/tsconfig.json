{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mark1russell7/cue/ts/config/vite.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "isolatedDeclarations": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@mark1russell7/logger": [
        "../src/index.ts"
      ]
    }
  }
}
