{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedDeclarations": false,
    "noEmit": true,
    "rootDir": "${configDir}"
  },
  "include": ["${configDir}/src/**/*", "${configDir}/test/**/*", "${configDir}/*.config.ts"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
