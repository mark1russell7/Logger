{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/logger",
  "version": "1.0.0",
  "description": "Standalone logger with configurable transports and formatters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/Logger.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/Logger/issues"
  },
  "homepage": "https://github.com/mark1russell7/Logger#readme",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.9.3",
    "@mark1russell7/cue": "^1.0.2",
    "vitest": "^3.0.0",
    "@mark1russell7/test": "github:mark1russell7/test#main"
  },
  "publishConfig": {
    "access": "public"
  }
}
