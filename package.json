{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/logger",
  "version": "1.1.3",
  "description": "Standalone logger with configurable transports and formatters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/Logger.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/Logger/issues"
  },
  "homepage": "https://mark1russell7.github.io/Logger/",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && node -e \"fs.copyFileSync('src/log-level.published.d.ts','dist/log-level.d.ts')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && pnpm --filter @logger/site run typecheck",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run && pnpm --filter @logger/site run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:conventions": "conventions check",
    "check:api": "api-report check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "!src/__tests__"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.3",
    "@mark1russell7/conventions": "^0.41.0",
    "@mark1russell7/cue": "^2.1.1",
    "@mark1russell7/test": "github:mark1russell7/test#11cc15dac38a6fc81dc497e46768c944c333a335",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
